/* Write your global styles here, in PostCSS syntax */
@tailwind base;
/* components/utilities layers dropped: nothing in the app uses Tailwind classes (was ~400 KB of CSS) */

/* Guards of Atlantis display fonts (used for hero names, headings) */
@font-face {
	font-family: 'Modesto Poster';
	src: url('./lib/fonts/modesto_poster.woff') format('woff');
	font-display: swap;
}
/* the whole app speaks in the Guards font; it has a single weight, so never fake a bold */
/* fixed root size: layouts look the same whatever the browser's default text size */
/* the page's own ground is the deep navy: an iPhone shows it behind the status bar and wherever the app doesn't paint */
html { font-size: 16px; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; background: #0c1220; color-scheme: dark; }
body { background: #0c1220; }
body { font-family: 'Modesto Poster', serif; font-synthesis: none; }
@font-face {
	font-family: 'Atlantis';
	src: url('./lib/fonts/atlantis_regular.woff') format('woff');
	font-display: swap;
}
/* Razzle's comic bursts (hud2/ComicBurst.svelte) — the one exception to the one-font rule (the user, 2026-10-20):
   comic lettering needs a comic face, the way card faces keep their own print fonts. Bangers, SIL OFL. */
@font-face {
	font-family: 'Bangers';
	src: url('./lib/fonts/bangers.woff2') format('woff2');
	font-display: block;
}

/* your hand's cards can be dragged into your own order (hud2/handSort.ts): a finger must be able to hold and slide
   them without the browser panning or opening its long-press menu; the held card rides above the others */
[data-h] { touch-action: none; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; }
[data-h].hsort { z-index: 50 !important; cursor: grabbing; filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.55)); transition: none !important; }
.hsorting [data-h]:not(.hsort) { transition: transform 0.15s ease, translate 0.15s ease; }
